diff --git a/drivers/can/can_mchp_pic32cz.c b/drivers/can/can_mchp_pic32cz.c
new file mode 100644
index 00000000000..9e3bfca9a49
--- /dev/null
+++ b/drivers/can/can_mchp_pic32cz.c
@@ -0,0 +1,264 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * CAN FD driver for the Microchip PIC32CZ CA family (Bosch M_CAN wrapper).
+ *
+ * Integration details (PIC32CZ CA80/CA90):
+ * - Each instance has a single NVIC interrupt line, so both M_CAN interrupt
+ *   lines are routed to line 0 (like the SAM0 wrapper).
+ * - The message RAM lives in system SRAM. The M_CAN 16-bit element addresses
+ *   provide address bits [15:0]; bits [23:16] come from the Microchip
+ *   MRCFG.OFFSET wrapper register (bits [31:24] are fixed to the SRAM
+ *   segment). The whole message RAM must therefore fit inside one 64 KiB
+ *   window, guaranteed here by a 4 KiB-aligned buffer of at most 4 KiB.
+ * - The core clock is a GCLK peripheral channel; the bus clock is an MCLK
+ *   enable. Both are managed through the pic32cz-ca clock-control driver.
+ */
+
+#include <zephyr/drivers/can.h>
+#include <zephyr/drivers/clock_control.h>
+#include <zephyr/drivers/pinctrl.h>
+#include <zephyr/irq.h>
+#include <zephyr/kernel.h>
+#include <zephyr/logging/log.h>
+
+#include "can_mcan.h"
+
+LOG_MODULE_REGISTER(can_mchp_pic32cz, CONFIG_CAN_LOG_LEVEL);
+
+#define DT_DRV_COMPAT microchip_pic32cz_can
+
+/* Microchip wrapper register: message RAM base address bits [23:16] */
+#define CAN_MCHP_MRCFG        0x08
+#define CAN_MCHP_MRCFG_OFFSET GENMASK(23, 16)
+
+struct can_mchp_pic32cz_config {
+	mm_reg_t base;
+	mem_addr_t mram;
+	size_t mram_size;
+	void (*config_irq)(void);
+	const struct pinctrl_dev_config *pcfg;
+	const struct device *clock_dev;
+	clock_control_subsys_t gclk_sys;
+	clock_control_subsys_t mclk_sys;
+};
+
+static int can_mchp_pic32cz_read_reg(const struct device *dev, uint16_t reg, uint32_t *val)
+{
+	const struct can_mcan_config *mcan_config = dev->config;
+	const struct can_mchp_pic32cz_config *mchp_config = mcan_config->custom;
+
+	return can_mcan_sys_read_reg(mchp_config->base, reg, val);
+}
+
+static int can_mchp_pic32cz_write_reg(const struct device *dev, uint16_t reg, uint32_t val)
+{
+	const struct can_mcan_config *mcan_config = dev->config;
+	const struct can_mchp_pic32cz_config *mchp_config = mcan_config->custom;
+
+	switch (reg) {
+	case CAN_MCAN_ILS:
+		/* Route all interrupts to M_CAN line 0 (single NVIC line) */
+		val = 0;
+		break;
+	case CAN_MCAN_ILE:
+		val = CAN_MCAN_ILE_EINT0;
+		break;
+	default:
+		break;
+	}
+
+	return can_mcan_sys_write_reg(mchp_config->base, reg, val);
+}
+
+static int can_mchp_pic32cz_read_mram(const struct device *dev, uint16_t offset, void *dst,
+				      size_t len)
+{
+	const struct can_mcan_config *mcan_config = dev->config;
+	const struct can_mchp_pic32cz_config *mchp_config = mcan_config->custom;
+
+	return can_mcan_sys_read_mram(mchp_config->mram, offset, dst, len);
+}
+
+static int can_mchp_pic32cz_write_mram(const struct device *dev, uint16_t offset, const void *src,
+				       size_t len)
+{
+	const struct can_mcan_config *mcan_config = dev->config;
+	const struct can_mchp_pic32cz_config *mchp_config = mcan_config->custom;
+
+	return can_mcan_sys_write_mram(mchp_config->mram, offset, src, len);
+}
+
+static int can_mchp_pic32cz_clear_mram(const struct device *dev, uint16_t offset, size_t len)
+{
+	const struct can_mcan_config *mcan_config = dev->config;
+	const struct can_mchp_pic32cz_config *mchp_config = mcan_config->custom;
+
+	return can_mcan_sys_clear_mram(mchp_config->mram, offset, len);
+}
+
+static void can_mchp_pic32cz_line_x_isr(const struct device *dev)
+{
+	can_mcan_line_0_isr(dev);
+	can_mcan_line_1_isr(dev);
+}
+
+static int can_mchp_pic32cz_get_core_clock(const struct device *dev, uint32_t *rate)
+{
+	const struct can_mcan_config *mcan_config = dev->config;
+	const struct can_mchp_pic32cz_config *mchp_config = mcan_config->custom;
+
+	return clock_control_get_rate(mchp_config->clock_dev, mchp_config->gclk_sys, rate);
+}
+
+static int can_mchp_pic32cz_init(const struct device *dev)
+{
+	const struct can_mcan_config *mcan_config = dev->config;
+	const struct can_mchp_pic32cz_config *mchp_config = mcan_config->custom;
+	uint32_t mrcfg;
+	int ret;
+
+	ret = clock_control_on(mchp_config->clock_dev, mchp_config->mclk_sys);
+	if (ret < 0 && ret != -EALREADY) {
+		LOG_ERR("failed to enable bus clock (%d)", ret);
+		return ret;
+	}
+
+	ret = clock_control_on(mchp_config->clock_dev, mchp_config->gclk_sys);
+	if (ret < 0 && ret != -EALREADY) {
+		LOG_ERR("failed to enable core clock (%d)", ret);
+		return ret;
+	}
+
+	ret = pinctrl_apply_state(mchp_config->pcfg, PINCTRL_STATE_DEFAULT);
+	if (ret < 0) {
+		LOG_ERR("failed to apply pinctrl (%d)", ret);
+		return ret;
+	}
+
+	/* The M_CAN master address is 0x20000000 | OFFSET << 16 | addr[15:0],
+	 * where OFFSET is MRCFG bits [23:16] and addr[15:0] comes from the
+	 * element address registers. Two consequences: the message RAM must
+	 * fit inside a single 64 KiB window, and it must live in DMA-visible
+	 * FLEXRAM (0x20020000+) -- NOT in the CPU-private DTCM that occupies
+	 * the first 128 KiB of the 0x20000000 space.
+	 */
+	uint32_t mrba = mchp_config->mram & 0xFFFF0000U;
+	uint32_t mram_end = mchp_config->mram + mchp_config->mram_size - 1U;
+
+	if (mchp_config->mram < 0x20020000U) {
+		LOG_ERR("message RAM at 0x%08x is in DTCM, not DMA-visible FLEXRAM",
+			(uint32_t)mchp_config->mram);
+		return -EINVAL;
+	}
+
+	if ((mram_end & 0xFFFF0000U) != mrba) {
+		LOG_ERR("message RAM 0x%08x..0x%08x straddles a 64 KiB window",
+			(uint32_t)mchp_config->mram, mram_end);
+		return -EINVAL;
+	}
+
+	ret = can_mcan_configure_mram(dev, mrba, mchp_config->mram);
+	if (ret != 0) {
+		return ret;
+	}
+
+	/* configure_mram left the core in init mode with CCE set, which the
+	 * (enable-protected) MRCFG wrapper register requires.
+	 */
+	mrcfg = mchp_config->mram & CAN_MCHP_MRCFG_OFFSET;
+	sys_write32(mrcfg, mchp_config->base + CAN_MCHP_MRCFG);
+	if (sys_read32(mchp_config->base + CAN_MCHP_MRCFG) != mrcfg) {
+		LOG_ERR("MRCFG readback mismatch (wrote 0x%08x)", mrcfg);
+		return -EIO;
+	}
+
+	ret = can_mcan_init(dev);
+	if (ret != 0) {
+		LOG_ERR("failed to init mcan (%d)", ret);
+		return ret;
+	}
+
+	mchp_config->config_irq();
+
+	return 0;
+}
+
+static DEVICE_API(can, can_mchp_pic32cz_driver_api) = {
+	.get_capabilities = can_mcan_get_capabilities,
+	.start = can_mcan_start,
+	.stop = can_mcan_stop,
+	.set_mode = can_mcan_set_mode,
+	.set_timing = can_mcan_set_timing,
+	.send = can_mcan_send,
+	.add_rx_filter = can_mcan_add_rx_filter,
+	.remove_rx_filter = can_mcan_remove_rx_filter,
+	.get_state = can_mcan_get_state,
+#ifdef CONFIG_CAN_MANUAL_RECOVERY_MODE
+	.recover = can_mcan_recover,
+#endif /* CONFIG_CAN_MANUAL_RECOVERY_MODE */
+	.get_core_clock = can_mchp_pic32cz_get_core_clock,
+	.get_max_filters = can_mcan_get_max_filters,
+	.set_state_change_callback = can_mcan_set_state_change_callback,
+	.timing_min = CAN_MCAN_TIMING_MIN_INITIALIZER,
+	.timing_max = CAN_MCAN_TIMING_MAX_INITIALIZER,
+#ifdef CONFIG_CAN_FD_MODE
+	.set_timing_data = can_mcan_set_timing_data,
+	.timing_data_min = CAN_MCAN_TIMING_DATA_MIN_INITIALIZER,
+	.timing_data_max = CAN_MCAN_TIMING_DATA_MAX_INITIALIZER,
+#endif /* CONFIG_CAN_FD_MODE */
+};
+
+static const struct can_mcan_ops can_mchp_pic32cz_ops = {
+	.read_reg = can_mchp_pic32cz_read_reg,
+	.write_reg = can_mchp_pic32cz_write_reg,
+	.read_mram = can_mchp_pic32cz_read_mram,
+	.write_mram = can_mchp_pic32cz_write_mram,
+	.clear_mram = can_mchp_pic32cz_clear_mram,
+};
+
+#define CAN_MCHP_PIC32CZ_IRQ_CFG_FUNCTION(inst)                                                    \
+	static void config_can_##inst##_irq(void)                                                  \
+	{                                                                                          \
+		IRQ_CONNECT(DT_INST_IRQ_BY_NAME(inst, int0, irq),                                  \
+			    DT_INST_IRQ_BY_NAME(inst, int0, priority),                             \
+			    can_mchp_pic32cz_line_x_isr, DEVICE_DT_INST_GET(inst), 0);             \
+		irq_enable(DT_INST_IRQ_BY_NAME(inst, int0, irq));                                  \
+	}
+
+#define CAN_MCHP_PIC32CZ_CFG_INST(inst)                                                            \
+	CAN_MCAN_DT_INST_CALLBACKS_DEFINE(inst, can_mchp_pic32cz_cbs_##inst);                      \
+                                                                                                   \
+	static const struct can_mchp_pic32cz_config can_mchp_pic32cz_cfg_##inst = {                \
+		.base = CAN_MCAN_DT_INST_MCAN_ADDR(inst),                                          \
+		.mram = (mem_addr_t)CAN_MCAN_DT_INST_MRAM_ADDR(inst),                              \
+		.mram_size = CAN_MCAN_DT_INST_MRAM_SIZE(inst),                                     \
+		.clock_dev = DEVICE_DT_GET(DT_NODELABEL(clock)),                                   \
+		.gclk_sys = (void *)(DT_INST_CLOCKS_CELL_BY_NAME(inst, gclk, subsystem)),          \
+		.mclk_sys = (void *)(DT_INST_CLOCKS_CELL_BY_NAME(inst, mclk, subsystem)),          \
+		.pcfg = PINCTRL_DT_INST_DEV_CONFIG_GET(inst),                                      \
+		.config_irq = config_can_##inst##_irq,                                             \
+	};                                                                                         \
+                                                                                                   \
+	static const struct can_mcan_config can_mcan_cfg_##inst = CAN_MCAN_DT_CONFIG_INST_GET(     \
+		inst, &can_mchp_pic32cz_cfg_##inst, &can_mchp_pic32cz_ops,                         \
+		&can_mchp_pic32cz_cbs_##inst);
+
+#define CAN_MCHP_PIC32CZ_DATA_INST(inst) CAN_MCAN_DATA_DEFINE(can_mcan_data_##inst, NULL);
+
+#define CAN_MCHP_PIC32CZ_DEVICE_INST(inst)                                                         \
+	CAN_DEVICE_DT_INST_DEFINE(inst, can_mchp_pic32cz_init, NULL, &can_mcan_data_##inst,        \
+				  &can_mcan_cfg_##inst, POST_KERNEL, CONFIG_CAN_INIT_PRIORITY,     \
+				  &can_mchp_pic32cz_driver_api);
+
+#define CAN_MCHP_PIC32CZ_INST(inst)                                                                \
+	CAN_MCAN_DT_INST_BUILD_ASSERT_MRAM_CFG(inst);                                              \
+	PINCTRL_DT_INST_DEFINE(inst);                                                              \
+	CAN_MCHP_PIC32CZ_IRQ_CFG_FUNCTION(inst)                                                    \
+	CAN_MCHP_PIC32CZ_CFG_INST(inst)                                                            \
+	CAN_MCHP_PIC32CZ_DATA_INST(inst)                                                           \
+	CAN_MCHP_PIC32CZ_DEVICE_INST(inst)
+
+DT_INST_FOREACH_STATUS_OKAY(CAN_MCHP_PIC32CZ_INST)
