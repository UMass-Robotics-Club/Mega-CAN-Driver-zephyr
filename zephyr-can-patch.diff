+
+description: |
+  Microchip PIC32CZ CA CAN FD controller (Bosch M_CAN based).
+
+  The message RAM is allocated in system SRAM by the driver; the Microchip
+  MRCFG wrapper register supplies address bits [23:16] of the message RAM
+  base, so the whole message RAM must fit within a single 64 KiB window.
+
+compatible: "microchip,pic32cz-can"
+
+include:
+  - name: bosch,m_can-base.yaml
+  - name: pinctrl-device.yaml
+
+properties:
+  reg:
+    required: true
+
+  interrupts:
+    required: true
+
+  interrupt-names:
+    required: true
+
+  clocks:
+    required: true
+    description: |
+      MCLK (bus clock enable) and GCLK (core clock channel) entries from the
+      pic32cz-ca clock controller.
+
+  clock-names:
+    required: true
